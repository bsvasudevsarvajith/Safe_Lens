# ==============================================================================
# SafeRoute AI - Production Environment Variables Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or expose private keys to client bundles!
# ==============================================================================

# ------------------------------------------------------------------------------
# A. Map & Navigation Configuration
# ------------------------------------------------------------------------------
# Map provider: "mapbox" or "google" (Leaflet OpenStreetMap/CartoDB runs out of the box without keys)
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSyYourGoogleMapsApiKeyHere
GOOGLE_DIRECTIONS_API_KEY=AIzaSyYourServerSideDirectionsApiKeyHere

# ------------------------------------------------------------------------------
# B. AI & Computer Vision Telemetry Configuration
# ------------------------------------------------------------------------------
# Provider: "google_gemini", "custom_vision", or "simulation_engine"
AI_MODEL_PROVIDER=google_gemini
AI_MODEL_NAME=gemini-1.5-flash
AI_API_KEY=your_gemini_or_vision_api_key_here
AI_ENDPOINT_URL=https://your-custom-cctv-vision-endpoint.com/v1/analyze

# ------------------------------------------------------------------------------
# C. Firebase Client & Admin SDK Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Server-side Firebase Admin SDK (used in secure Server Actions and API routes)
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# D. Emergency Services Telephone Hotlines
# ------------------------------------------------------------------------------
NEXT_PUBLIC_EMERGENCY_POLICE_PHONE=112
NEXT_PUBLIC_EMERGENCY_AMBULANCE_PHONE=108
NEXT_PUBLIC_EMERGENCY_WOMEN_HELPLINE=1091

# ------------------------------------------------------------------------------
# E. Hosting & Deployment Environment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
